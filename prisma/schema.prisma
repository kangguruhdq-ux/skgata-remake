datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("ADMIN") // SUPERADMIN, ADMIN, EDITOR
  password  String   @default("skagata2026")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  category    String   // Berita, Pengumuman, Artikel, SPMB
  coverImage  String
  author      String   @default("Humas SMKN 3 Yogyakarta")
  views       Int      @default(0)
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Major {
  id             String   @id @default(cuid())
  code           String   @unique // BP, TJKT, DPIB, TKP, TE, TITL, TKRO, TP
  name           String
  slug           String   @unique
  colorBadge     String
  tagline        String
  description    String
  curriculum     String   // text or JSON
  careerProspects String  // text or JSON
  industryPartners String // text or JSON
  facilities     String   // text or JSON
  coverImage     String
  headOfMajor    String?
  totalStudents  Int      @default(250)
  isFeatured     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TeacherStaff {
  id        String   @id @default(cuid())
  name      String
  nip       String?
  role      String   // Kepala Sekolah, Wakil Kepala Sekolah, Guru Produktif, Guru Normatif/Adaptif, Tenaga Kependidikan
  department String? // Kejuruan atau Bagian
  subject   String?  // Mata Pelajaran
  photo     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobVacancy {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  type        String   // Full-Time, Magang Industri, Program Jepang
  description String
  requirements String
  deadline    DateTime
  linkApply   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceLink {
  id          String   @id @default(cuid())
  name        String
  category    String   // Akademik, Penilaian, Perpustakaan, Pengaduan, Administrasi
  description String
  url         String
  icon        String
  badge       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id               String   @id @default("default")
  schoolName       String   @default("SMK Negeri 3 Yogyakarta")
  tagline          String   @default("Konsisten Mencetak Teknisi Unggul, Berkarakter Taruna & Budaya")
  phone            String   @default("(0274) 513503")
  email            String   @default("humas@smkn3jogja.sch.id")
  address          String   @default("Jl. R.W. Monginsidi No. 2, Jetis, Yogyakarta (STM 2 Jetis)")
  headmaster       String   @default("Widada, S.Pd., M.Pd.")
  logoUrl          String   @default("/media/school/logo.webp")
  faviconUrl       String   @default("/favicon.ico")
  metaTitle        String   @default("SMK Negeri 3 Yogyakarta | STM 2 Jetis Unggul & Berkarakter")
  metaDescription  String   @default("Website resmi SMK Negeri 3 Yogyakarta (STM 2 Jetis). Konsisten mencetak teknisi unggul berstandar industri dengan 8 konsentrasi keahlian.")
  metaKeywords     String   @default("SMK Negeri 3 Yogyakarta, STM 2 Jetis, SMKN 3 Jogja, SMK Vokasi Yogyakarta, Sekolah Kejuruan Teknik")
  socialInstagram  String   @default("https://www.instagram.com/smkn3jogja")
  socialYoutube    String   @default("https://www.youtube.com/@smknegeri3yogyakarta")
  socialTiktok     String   @default("https://www.tiktok.com/@smkn3jogja")
  socialFacebook   String   @default("https://www.facebook.com/smkn3jogja")
  socialTwitter    String   @default("https://twitter.com/smkn3jogja")
  activeVideoId    String   @default("tJhzVg7Nq4g")
  spmbActive       Boolean  @default(true)
  spmbUrl          String   @default("https://smkn3jogja.sch.id/pengumuman/")
  navLinks         String?  // JSON array of customizable navigation items
  updatedAt        DateTime @updatedAt
}

model OrganizationNode {
  id          String   @id @default(cuid())
  name        String
  nip         String?
  position    String   // e.g. Kepala Sekolah, Komite Sekolah, Wakasek, dsb.
  department  String?  // Bagian / Divisi / Jurusan
  level       Int      @default(1) // 1: Puncak, 2: Wakasek & KTU, 3: Kaprogli / Koordinator, 4: Unit / Staf
  order       Int      @default(0)
  photo       String?
  task        String?  // Deskripsi tugas / uraian peran
  parentId    String?
  parent      OrganizationNode?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    OrganizationNode[] @relation("OrgHierarchy")
  isActive    Boolean  @default(true)
  period      String?  @default("2025/2026")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
  @@index([order])
  @@index([isActive])
}

model MediaItem {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  category     String   @default("general") // general, news, major, teacher, facility, archive
  alt          String?
  usageContext String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model VisitorLog {
  id        String   @id @default(cuid())
  ip        String
  path      String
  userAgent String?
  referer   String?
  device    String?  // desktop, mobile, tablet
  browser   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([ip])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   // Nama/email petugas admin
  action    String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, SETTINGS_CHANGE, CLEAR_LOGS, MEDIA_UPLOAD, MEDIA_DELETE
  entity    String   // POST, MAJOR, TEACHER, ORG_NODE, MEDIA, SETTINGS, SYSTEM, AUTH
  entityId  String?
  details   String?  // Deskripsi aksi atau JSON diff
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity])
}

model CmsData {
  id        String   @id @default("singleton")
  data      String   // Full JSON snapshot of CMSState
  updatedAt DateTime @updatedAt
}

